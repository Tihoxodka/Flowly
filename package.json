{
  "name": "budgeter",
  "productName": "Budgeter",
  "version": "2.0.0",
  "description": "Monthly budget planner for income, bills, spending, accounts, debt, trends and goals. Your data stays on your computer.",
  "author": "Sean Keehan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReckingBallResearch/Budgeter.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.suckuhpunch.budgeter",
    "productName": "Budgeter",
    "files": [
      "main.js",
      "preload.js",
      "pdf-worker.js",
      "app/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "Budgeter"
    }
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  }
}
