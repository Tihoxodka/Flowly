{
  "name": "flowly",
  "productName": "Flowly",
  "version": "2.0.0",
  "description": "Monthly budget planner for income, bills, spending, accounts, debt, trends and goals. Your data stays on your computer.",
  "author": "Tihoxodka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tihoxodka/Flowly.git"
  },
  "main": "main.js",
  "scripts": {
    "build": "node build.mjs",
    "prestart": "npm run build",
    "start": "electron .",
    "pretest": "npm run build",
    "test": "node --test test/",
    "pree2e": "npm run build",
    "e2e": "node test/e2e/run.mjs",
    "dist": "npm run build && electron-builder --mac --arm64",
    "typecheck": "tsc -p jsconfig.json",
    "i18n:check": "node i18n-check.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "com.tihoxodka.flowly",
    "productName": "Flowly",
    "files": [
      "main.js",
      "preload.js",
      "pdf-worker.js",
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "Flowly"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  }
}
